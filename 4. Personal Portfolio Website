<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio</title>

<style>
* { margin:0; padding:0; box-sizing:border-box; font-family:Segoe UI; }

body {
  scroll-behavior:smooth;
  background:#0f2027;
  color:white;
}

/* ===== NAVBAR ===== */
nav {
  position:fixed;
  width:100%;
  display:flex;
  justify-content:space-between;
  padding:15px 30px;
  background:transparent;
  transition:0.3s;
  z-index:1000;
}

nav.scrolled { background:#111; }

nav ul {
  display:flex;
  list-style:none;
}

nav ul li { margin:0 15px; }

nav ul li a {
  color:white;
  text-decoration:none;
  transition:0.3s;
}

nav ul li a:hover { color:#00f2fe; }

/* ===== HERO ===== */
.hero {
  height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  flex-direction:column;
  background:linear-gradient(135deg,#4facfe,#00f2fe);
  text-align:center;
}

.hero img {
  width:120px;
  border-radius:50%;
  margin-bottom:15px;
  border:3px solid white;
}

.hero h1 { font-size:2.5em; }
.hero p { margin:10px 0; }

/* ===== SECTIONS ===== */
section {
  padding:80px 20px;
  text-align:center;
}

/* ===== ABOUT ===== */
.about {
  background:#222;
}

/* ===== SKILLS ===== */
.skills {
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
}

.skill {
  background:#333;
  margin:10px;
  padding:15px;
  border-radius:10px;
  width:120px;
}

/* ===== PROJECTS ===== */
.projects {
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
}

.project {
  background:#333;
  margin:10px;
  padding:20px;
  border-radius:10px;
  width:200px;
}

/* ===== CONTACT ===== */
.contact {
  background:#222;
}

button {
  padding:10px 15px;
  border:none;
  background:#00f2fe;
  color:black;
  cursor:pointer;
  border-radius:5px;
}

/* ===== RESPONSIVE ===== */
@media(max-width:768px){
  nav ul { display:none; }
}
</style>
</head>

<body>

<!-- NAV -->
<nav id="nav">
  <h2>MyPortfolio</h2>
  <ul>
    <li><a href="#home">Home</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#skills">Skills</a></li>
    <li><a href="#projects">Projects</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- HOME -->
<section class="hero" id="home">
  <img src="https://via.placeholder.com/120" alt="profile">
  <h1>Your Name</h1>
  <p>Web Developer | Designer | Programmer</p>
  <p>I build modern and responsive websites.</p>
</section>

<!-- ABOUT -->
<section class="about" id="about">
  <h2>About Me</h2>
  <p>
    I am a passionate web developer with knowledge in HTML, CSS, JavaScript,
    and modern frameworks. I enjoy creating responsive and user-friendly websites.
  </p>
  <p>
    🎓 Education: BCA Student  
    💼 Experience: Web Projects & Internships
  </p>
</section>

<!-- SKILLS -->
<section id="skills">
  <h2>Skills</h2>
  <div class="skills">
    <div class="skill">HTML</div>
    <div class="skill">CSS</div>
    <div class="skill">JavaScript</div>
    <div class="skill">Python</div>
    <div class="skill">C++</div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects">
  <h2>Projects</h2>
  <div class="projects">
    <div class="project">Stopwatch App</div>
    <div class="project">Tic Tac Toe</div>
    <div class="project">Portfolio Website</div>
  </div>
</section>

<!-- CONTACT -->
<section class="contact" id="contact">
  <h2>Contact</h2>
  <p>Email: your@email.com</p>
  <button onclick="alert('Message sent!')">Send Message</button>
</section>

<script>
// Navbar scroll effect
window.addEventListener("scroll", function(){
  let nav = document.getElementById("nav");
  if(window.scrollY > 50){
    nav.classList.add("scrolled");
  } else {
    nav.classList.remove("scrolled");
  }
});
</script>

</body>
</html>
